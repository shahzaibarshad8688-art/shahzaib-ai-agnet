# Copy this file to .env and fill in your values.
# The agent works WITHOUT any keys using the built-in Autonomous Engine.

# Server port — frontend + backend are served together on this port
PORT=3000

# AI Provider API Keys (all optional — leave blank to use built-in engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
